<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                xmlns:vm="clr-namespace:MadarfigyeloApp.ViewModels"
                xmlns:models="clr-namespace:MadarfigyeloApp.Models"
                xmlns:pages="clr-namespace:MadarfigyeloApp.Views"
                xmlns:res="clr-namespace:MadarfigyeloApp.Resources"
                xmlns:util="clr-namespace:MadarfigyeloApp.Utilities"
                x:Class="MadarfigyeloApp.Views.LatogatasView"
                x:DataType="vm:LatogatasViewModel"
                Title="{x:Static res:AppRes.Latogatasok}">

    <Grid RowDefinitions="*,50">
        <Image Grid.Row="0"
               Grid.RowSpan="2"
               Opacity="0.4"
               Source="hello.jpg"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />
        <CollectionView ItemsSource="{Binding LatogatasList}" 
                        Grid.Row="0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Latogatas">
                    <Border Background="{StaticResource Secondary }"
                            HorizontalOptions="Fill"
                            Margin="5,5,5,0"
                            Padding="5"
                            StrokeShape="RoundRectangle 5">
                        <toolkit:Expander>
                            <toolkit:Expander.Header>
                                <Grid ColumnDefinitions="*,*,*"
                                      RowDefinitions="30">
                                    <Label Text="{Binding Odu.OduAzonosito}"
                                           Grid.Column="0"
                                           Style="{StaticResource ListTextHeader}" />
                                    <Label Text="{Binding Datum}"                                           
                                           Grid.Column="1"
                                           Style="{StaticResource ListTextHeader}" />
                                    <Label Text="{Binding Tevekenyseg, Converter={util:EnumToResxConverter}}"
                                           Grid.Column="2"
                                           Style="{StaticResource ListTextHeader}" />
                                </Grid>
                            </toolkit:Expander.Header>

                            <Grid ColumnDefinitions="*,*,*"
                                  RowDefinitions="30,30">
                                <Label Text="{Binding Allapot, Converter={util:EnumToResxConverter}}"
                                       Grid.Column="0"
                                       Grid.Row="0"
                                       Style="{StaticResource ListText}" />
                                <Label Text="{Binding Faj}"
                                       Grid.Column="1"
                                       Grid.Row="0"                                       
                                       Style="{StaticResource ListText}" />                             
                                <Label Text="{Binding TojasSzam, StringFormat={x:Static res:AppRes.TojasokSzama}}"
                                       Grid.Column="2"
                                       Grid.Row="0"                                       
                                       Style="{StaticResource ListText}" />

                                <Label Text="{Binding FiokaSzam, StringFormat={x:Static res:AppRes.FiokakSzama}}"
                                       Grid.Column="0"
                                       Grid.Row="1"
                                       Style="{StaticResource ListText}" />

                                <Label Text="{Binding FiokakKora, StringFormat={x:Static res:AppRes.FiokakKora}}"
                                       Grid.Column="1"
                                       Grid.Row="1"
                                       Style="{StaticResource ListText}" />
                                
                                <Label Text="{Binding Megjegyzesek}"
                                       Grid.Column="2"
                                       Grid.Row="1"
                                       Style="{StaticResource ListText}" />                                
                              
                            </Grid>
                        </toolkit:Expander>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="{x:Static res:AppRes.UjLatogatas}"
                Command="{Binding NewLatogatasCommand}"
                Grid.Row="1"/>
    </Grid>
</pages:BasePage>