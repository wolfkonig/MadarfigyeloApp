<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="MadarfigyeloApp.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:MadarfigyeloApp"
       xmlns:views="clr-namespace:MadarfigyeloApp.Views"
       xmlns:res="clr-namespace:MadarfigyeloApp.Resources"
       Title="MadarfigyeloApp">
    <TabBar>
        <ShellContent Title="{x:Static res:AppRes.Home}"
                      ContentTemplate="{DataTemplate local:MainPage}"
                      Route="mainPage"
                      Icon="tree_house.svg"/>

        <ShellContent Title="{x:Static res:AppRes.Odutelepek}"
                      ContentTemplate="{DataTemplate views:OdutelepView}"
                      Route="odutelep"
                      Icon="bird_house.svg"/>
    </TabBar>
</Shell>
