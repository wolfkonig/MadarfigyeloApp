<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                xmlns:vm="clr-namespace:Terepnaplo.ViewModels"
                xmlns:models="clr-namespace:Terepnaplo.Models"
                xmlns:pages="clr-namespace:Terepnaplo.Views"
                xmlns:res="clr-namespace:Terepnaplo.Resources"
                xmlns:conv="clr-namespace:Terepnaplo.Converters"
                x:Class="Terepnaplo.Views.LatogatasView"
                x:DataType="vm:LatogatasViewModel"
                Title="{x:Static res:AppRes.Latogatasok}"
                x:Name="latogatasRoot">

    <Grid RowDefinitions="50,*,50">
        <Image Grid.Row="0"
               Grid.RowSpan="3"
               Opacity="0.4"
               Source="hello.jpg"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <Grid ColumnDefinitions="40,6*,6*,5*"
              Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
              Opacity="0.6">

            <ImageButton Source="{AppThemeBinding Light=refresh.png, Dark=refresh_white.png}"
                         Command="{Binding RefreshCommand}"
                         HorizontalOptions="End"
                         Margin="5,0,0,0"
                         Grid.Column="0" />

            <Picker ItemsSource="{Binding OdutelepList}"
                    ItemDisplayBinding="{Binding Azonosito, Converter={conv:EmptyToNoneSelectedConverter}}"
                    SelectedItem="{Binding SelectedOdutelep}"
                    FontSize="Medium"
                    Grid.Column="1" 
                    Style="{StaticResource FilterPicker}" />

            <Picker ItemsSource="{Binding OduList}"
                    ItemDisplayBinding="{Binding OduAzonosito, Converter={conv:EmptyToNoneSelectedConverter}}"
                    SelectedItem="{Binding SelectedOdu}"
                    FontSize="Medium"
                    Grid.Column="2" 
                    Style="{StaticResource FilterPicker}" />

            <Button Text="{x:Static res:AppRes.Edit}"
                    Command="{Binding EditOduCommand}"
                    CommandParameter="{Binding SelectedOdu.Id}"
                    BackgroundColor="White"
                    TextColor="Black"
                    BorderColor="{StaticResource OffBlack}"
                    BorderWidth="1"
                    Grid.Column="3"/>
        </Grid>
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing, Mode=OneWay}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding LatogatasList}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Latogatas">
                        <Border Background="{StaticResource Secondary }"
                                HorizontalOptions="Fill"
                                Margin="5,5,5,0"
                                Padding="5"
                                StrokeShape="RoundRectangle 5">
                            <toolkit:Expander>
                                <toolkit:Expander.Header>
                                    <Grid ColumnDefinitions="2*,4*,2*"
                                          RowDefinitions="30">
                                        <Label Text="{Binding Odu.OduAzonosito}"
                                               Grid.Column="0"
                                               HorizontalOptions="Start"
                                               Style="{StaticResource ListTextHeader}" />
                                        <Label Text="{Binding Datum}"
                                               Grid.Column="1"
                                               HorizontalOptions="Center"
                                               Style="{StaticResource ListTextHeader}" />
                                        <Label Text="{Binding Tevekenyseg, Converter={conv:EnumToResxConverter}}"
                                               Grid.Column="2"
                                               HorizontalOptions="End"
                                               Style="{StaticResource ListTextHeader}" />
                                    </Grid>
                                </toolkit:Expander.Header>

                                <Grid ColumnDefinitions="*,*"
                                      RowDefinitions="*,30">
                                    <FlexLayout Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                JustifyContent="SpaceBetween"
                                                Wrap="Wrap">
                                        <Label Text="{Binding Allapot, Converter={conv:EnumToResxConverter}}"
                                               IsVisible="{Binding Allapot, Converter={toolkit:IsNotNullConverter}}"
                                               Style="{StaticResource ListText}" />

                                        <Label Text="{Binding Faj}"
                                               IsVisible="{Binding Faj, Converter={toolkit:IsNotNullConverter}}"
                                               Style="{StaticResource ListText}" />
                                        
                                        <Label Text="{Binding TojasSzam, StringFormat={x:Static res:AppRes.TojasokSzamaX}}"
                                               IsVisible="{Binding TojasSzam, Converter={toolkit:IsNotNullConverter}}"
                                               Style="{StaticResource ListText}" />

                                        <Label Text="{Binding FiokaSzam, StringFormat={x:Static res:AppRes.FiokakSzamaX}}"
                                               IsVisible="{Binding FiokaSzam, Converter={toolkit:IsNotNullConverter}}"
                                               Style="{StaticResource ListText}" />

                                        <Label Text="{Binding FiokakKora, StringFormat={x:Static res:AppRes.FiokakKoraX}}"
                                               IsVisible="{Binding FiokakKora, Converter={toolkit:IsNotNullConverter}}"
                                               Style="{StaticResource ListText}" />

                                        <Label Text="{Binding Megjegyzesek}"
                                               IsVisible="{Binding Megjegyzesek, Converter={toolkit:IsStringNotNullOrWhiteSpaceConverter}}"
                                               Style="{StaticResource ListText}" />
                                    </FlexLayout>

                                    <Button Text="{x:Static res:AppRes.EditLatogatas}"
                                            Margin="0"
                                            Padding="0"
                                            Grid.Column="0"
                                            Grid.Row="1"
                                            Command="{Binding BindingContext.EditLatogatasCommand, Source={x:Reference latogatasRoot}}"
                                            CommandParameter="{Binding Id}" />

                                    <Button Text="{x:Static res:AppRes.DeleteLatogatas}"
                                            Margin="5,0,0,0"
                                            Padding="0"
                                            Grid.Column="1"
                                            Grid.Row="1"
                                            Command="{Binding BindingContext.DeleteLatogatasCommand, Source={x:Reference latogatasRoot}}"
                                            CommandParameter="{Binding Id}" />

                                </Grid>
                            </toolkit:Expander>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Text="{x:Static res:AppRes.UjLatogatas}"
                Command="{Binding NewLatogatasCommand}"
                Grid.Row="2"/>
    </Grid>
</pages:BasePage>