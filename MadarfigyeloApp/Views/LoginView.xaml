<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:pages="clr-namespace:MadarfigyeloApp.Views"
                xmlns:vm="clr-namespace:MadarfigyeloApp.ViewModels"
                xmlns:res="clr-namespace:MadarfigyeloApp.Resources"
                x:Class="MadarfigyeloApp.Views.LoginView"
                x:DataType="vm:LoginViewModel"
                Title="{x:Static res:AppRes.AppTitle}"
                BackgroundColor="{StaticResource Secondary}"
                Shell.FlyoutBehavior="Disabled">
    
    <Border VerticalOptions="Center"
            BackgroundColor="{StaticResource White}"
            StrokeShape="RoundRectangle 15"
            Margin="15">   
        <Grid RowDefinitions="40,40,*,50" 
              ColumnDefinitions="2*,3*"
              Margin="15">
            
            <Label Grid.Row="1"
                   Grid.Column="0"
                   Text="{x:Static res:AppRes.LoginName}" />
            <Entry Grid.Row="1"
                   Grid.Column="1"
                   Text="{Binding LoginName}" 
                   ClearButtonVisibility="WhileEditing"/>
            <Label Grid.Row="2"
                   Grid.Column="0"
                   Text="{x:Static res:AppRes.Password}" />
            <Entry Grid.Row="2"
                   Grid.Column="1"
                   IsPassword="True"
                   Text="{Binding Password}" />
            <Button Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Text="{x:Static res:AppRes.Login}"
                    Command="{Binding LoginCommand}" />
        </Grid>
    </Border>
</pages:BasePage>