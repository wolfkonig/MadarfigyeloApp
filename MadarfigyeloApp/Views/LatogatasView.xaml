<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                xmlns:vm="clr-namespace:MadarfigyeloApp.ViewModels"
                xmlns:models="clr-namespace:MadarfigyeloApp.Models"
                xmlns:pages="clr-namespace:MadarfigyeloApp.Views"
                x:Class="MadarfigyeloApp.Views.LatogatasView"
                x:DataType="vm:LatogatasViewModel"
                Title="Odu">

    <VerticalStackLayout>
        <CollectionView ItemsSource="{Binding LatogatasList}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Latogatas">
                    <Border Background="{StaticResource Secondary }"
                            HorizontalOptions="Fill"
                            Margin="5,5,5,0"
                            Padding="5"
                            StrokeShape="RoundRectangle 5">
                        <toolkit:Expander>
                            <toolkit:Expander.Header>
                                <Grid ColumnDefinitions="*,*,*"
                                      RowDefinitions="30">
                                    <Label Text="{Binding Odu.OduAzonosito}"
                                           Grid.Column="0"
                                           Style="{StaticResource ListTextHeader}" />
                                    <Label Text="{Binding Datum}"                                           
                                           Grid.Column="1"
                                           Style="{StaticResource ListTextHeader}" />
                                    <Label Text="{Binding Tevekenyseg}"
                                           Grid.Column="2"
                                           Style="{StaticResource ListTextHeader}" />
                                </Grid>
                            </toolkit:Expander.Header>

                            <Grid ColumnDefinitions="*,*,*"
                                  RowDefinitions="30,30">
                                <Label Text="{Binding Allapot}"
                                       Grid.Column="0"
                                       Grid.Row="0"
                                       Style="{StaticResource ListText}" />
                                <Label Text="{Binding Faj}"
                                       Grid.Column="1"
                                       Grid.Row="0"                                       
                                       Style="{StaticResource ListText}" />                             
                                <Label Text="{Binding TojasSzam, StringFormat='Tojasok szama: {0}'}"
                                       Grid.Column="2"
                                       Grid.Row="0"                                       
                                       Style="{StaticResource ListText}" />

                                <Label Text="{Binding FiokaSzam, StringFormat='Fiokak szama: {0}'}"
                                       Grid.Column="0"
                                       Grid.Row="1"
                                       Style="{StaticResource ListText}" />

                                <Label Text="{Binding FiokakKora, StringFormat='Fiokak kora: {0}'}"
                                       Grid.Column="1"
                                       Grid.Row="1"
                                       Style="{StaticResource ListText}" />
                                
                                <Label Text="{Binding Megjegyzesek}"
                                       Grid.Column="2"
                                       Grid.Row="1"
                                       Style="{StaticResource ListText}" />                                
                              
                            </Grid>
                        </toolkit:Expander>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</pages:BasePage>