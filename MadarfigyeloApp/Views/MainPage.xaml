<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:vm="clr-namespace:MadarfigyeloApp.ViewModels"
                xmlns:pages="clr-namespace:MadarfigyeloApp.Views"
                xmlns:res="clr-namespace:MadarfigyeloApp.Resources"
                x:Class="MadarfigyeloApp.Views.MainPage"
                x:DataType="vm:MainPageViewModel"
                Title="{x:Static res:AppRes.AppTitle}">

    <Grid RowDefinitions="50,*,30">

        <Grid ColumnDefinitions="Auto,*,40"
              BackgroundColor="White"
              Opacity="0.5"
              Grid.Row="0"
              ZIndex="1">

            <Label Grid.Column="0"
                   Margin="10,0,0,0"
                   Text="{Binding LoggedInUser, StringFormat={x:Static res:AppRes.LoggedInAs}}"
                   FontSize="Medium" />

            <ImageButton Grid.Column="2"
                         Margin="0,5,10,5"
                         HeightRequest="35"
                         Source="logout"
                         Command="{Binding LogoutCommand}" />
        </Grid>

        <Image Grid.Row="0" 
               ZIndex="0"
               Grid.RowSpan="3"
               Source="hello.jpg"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <Label Grid.Row="2"
               HorizontalOptions="End"
               TextColor="{StaticResource Accent}"
               Text="{Binding Version, StringFormat={x:Static res:AppRes.AppVersionX}}"
               Margin="0,0,10,0"/>
    </Grid>

</pages:BasePage>
