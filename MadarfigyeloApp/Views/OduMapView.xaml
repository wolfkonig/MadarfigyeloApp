<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:vm="clr-namespace:MadarfigyeloApp.ViewModels"
                xmlns:models="clr-namespace:MadarfigyeloApp.Models"
                xmlns:pages="clr-namespace:MadarfigyeloApp.Views"
                xmlns:res="clr-namespace:MadarfigyeloApp.Resources"
                xmlns:util="clr-namespace:MadarfigyeloApp.Utilities"
                xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
                x:Class="MadarfigyeloApp.Views.OduMapView"
                Title="OduMapView">

    <Grid RowDefinitions="50,*">

        <Grid ColumnDefinitions="2*,3*"
              Grid.Row="0"
              BackgroundColor="{StaticResource White}"
              Opacity="0.6">
            <Label Text="{x:Static res:AppRes.Odutelep}"
                   FontSize="Medium"
                   Grid.Column="0"
                   HorizontalOptions="End"
                   Padding="10,0,10,5" />

            <Picker ItemsSource="{Binding OdutelepList}"
                    ItemDisplayBinding="{Binding Azonosito}"
                    SelectedItem="{Binding SelectedOdutelep}"
                    FontSize="Medium"
                    Grid.Column="1" />
        </Grid>

        <maps:Map Grid.Row="1" 
                  x:Name="MyMap"
                  MapType="Street"
                  IsShowingUser="True" />
    </Grid>

</pages:BasePage>