<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MadarfigyeloApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MadarfigyeloApp"
    xmlns:views="clr-namespace:MadarfigyeloApp.Views"
    Title="MadarfigyeloApp">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="mainPage" />

    <ShellContent
        Title="Odutelep"
        ContentTemplate="{DataTemplate views:OdutelepView}"
        Route="odutelep"/>

</Shell>
