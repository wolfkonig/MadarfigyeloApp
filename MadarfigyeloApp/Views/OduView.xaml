<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                xmlns:vm="clr-namespace:MadarfigyeloApp.ViewModels"
                xmlns:models="clr-namespace:MadarfigyeloApp.Models"
                xmlns:pages="clr-namespace:MadarfigyeloApp.Views"
                xmlns:res="clr-namespace:MadarfigyeloApp.Resources"
                x:Class="MadarfigyeloApp.Views.OduView"
                x:DataType="vm:OduViewModel"
                Title="{x:Static res:AppRes.Oduk}">

    <Grid RowDefinitions="*,50">
        <Image Grid.Row="0"
               Grid.RowSpan="2"
               Opacity="0.4"
               Source="hello.jpg"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />
        <CollectionView ItemsSource="{Binding OduList}"
                        Grid.Row="0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Odu">
                    <Border Background="{StaticResource Secondary }"
                            HorizontalOptions="Fill"
                            Margin="5,5,5,0"
                            Padding="5"
                            StrokeShape="RoundRectangle 5">
                        <toolkit:Expander>
                            <toolkit:Expander.Header>
                                <Grid ColumnDefinitions="*,*,*"
                                      RowDefinitions="30">
                                    <Label Text="{Binding OduAzonosito}"
                                           Grid.Column="0"
                                           Style="{StaticResource ListTextHeader}" />
                                    <Label Text="{Binding Odutelep.Azonosito}"                                           
                                           Grid.Column="1"
                                           Style="{StaticResource ListTextHeader}" />
                                    <Label Text="{Binding OduTipus}"
                                           Grid.Column="2"
                                           Style="{StaticResource ListTextHeader}" />
                                </Grid>
                            </toolkit:Expander.Header>

                            <Grid ColumnDefinitions="*,*,*"
                                  RowDefinitions="30,30,30">
                                <Label Text="{Binding GpsLatitude}"
                                       Grid.Column="0"
                                       Grid.Row="0"
                                       Style="{StaticResource ListText}" />
                                <Label Text="{Binding GpsLongitude}"
                                       Grid.Column="1"
                                       Grid.Row="0"                                       
                                       Style="{StaticResource ListText}" />                             
                                <Label Text="{Binding BejaratiNyilasMm}"
                                       Grid.Column="2"
                                       Grid.Row="0"                                       
                                       Style="{StaticResource ListText}" />
                                
                                <Label Text="{Binding Elohelykod}"
                                       Grid.Column="0"
                                       Grid.Row="1"
                                       Style="{StaticResource ListText}" />
                                
                                <Label Text="{Binding MireVanHelyezve}"
                                       Grid.Column="1"
                                       Grid.Row="1"
                                       Style="{StaticResource ListText}" />
                                
                                <Label Text="{Binding FelhelyezesModja}"
                                       Grid.Column="2"
                                       Grid.Row="1"
                                       Style="{StaticResource ListText}" />
                                
                                <Label Text="{Binding OduTajolasa}"
                                       Grid.Column="0"
                                       Grid.Row="2"
                                       Style="{StaticResource ListText}" />

                                <Label Text="{Binding OdutTartoNovenyfaj}"
                                       Grid.Column="1"
                                       Grid.Row="2"
                                       Style="{StaticResource ListText}" />

                                <Label Text="{Binding MagassagMeter}"
                                       Grid.Column="2"
                                       Grid.Row="2"
                                       Style="{StaticResource ListText}" />
                            </Grid>
                        </toolkit:Expander>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="{x:Static res:AppRes.UjOdu}"
                Command="{Binding NewOduCommand}"
                Grid.Row="1"/>

    </Grid>
</pages:BasePage>