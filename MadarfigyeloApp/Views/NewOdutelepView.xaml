<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                xmlns:vm="clr-namespace:MadarfigyeloApp.ViewModels"
                xmlns:models="clr-namespace:MadarfigyeloApp.Models"
                xmlns:pages="clr-namespace:MadarfigyeloApp.Views"
                xmlns:res="clr-namespace:MadarfigyeloApp.Resources"
                x:Class="MadarfigyeloApp.Views.NewOdutelepView"
                x:DataType="vm:NewOdutelepViewModel"
                Title="{x:Static res:AppRes.UjOdutelep}">

    <ScrollView>
        <Grid Padding="20"
              ColumnSpacing="15"
              RowSpacing="10"
              ColumnDefinitions="Auto, *"
              RowDefinitions="*, *, *, *, *, *, *, *, *, *, *">

            <Label Text="{x:Static res:AppRes.Azonosito}"
                   Grid.Row="0"
                   Grid.Column="0"
                   VerticalOptions="Center" />
            <Entry Text="{Binding Azonosito}"
                   Grid.Row="0"
                   Grid.Column="1" />

            <Label Text="{x:Static res:AppRes.Telepules}"
                   Grid.Row="1"
                   Grid.Column="0"
                   VerticalOptions="Center" />
            <Entry Text="{Binding Telepules}"
                   Grid.Row="1"
                   Grid.Column="1" />

            <Label Text="{x:Static res:AppRes.TeruletNev}"
                   Grid.Row="2"
                   Grid.Column="0"
                   VerticalOptions="Center" />
            <Entry Text="{Binding TeruletNev}"
                   Grid.Row="2"
                   Grid.Column="1" />

            <Label Text="{x:Static res:AppRes.UtmNegyzetKod}"
                   Grid.Row="3"
                   Grid.Column="0"
                   VerticalOptions="Center" />
            <Entry Text="{Binding UtmNegyzetKod}"
                   Grid.Row="3"
                   Grid.Column="1" />

            <Label Text="{x:Static res:AppRes.KezeloSzervezetNev}"
                   Grid.Row="4"
                   Grid.Column="0"
                   VerticalOptions="Center" />
            <Entry Text="{Binding KezeloSzervezetNev}"
                   Grid.Row="4"
                   Grid.Column="1" />

            <Label Text="{x:Static res:AppRes.FelelosSzemelyNev}"
                   Grid.Row="5"
                   Grid.Column="0"
                   VerticalOptions="Center" />
            <Entry Text="{Binding FelelosSzemelyNev}"
                   Grid.Row="5"
                   Grid.Column="1" />

            <Label Text="{x:Static res:AppRes.FelelosSzemelyCim}"
                   Grid.Row="6"
                   Grid.Column="0"
                   VerticalOptions="Center" />
            <Entry Text="{Binding FelelosSzemelyCim}"
                   Grid.Row="6"
                   Grid.Column="1" />

            <Label Text="{x:Static res:AppRes.FelelosSzemelyTelefonszam}"
                   Grid.Row="7"
                   Grid.Column="0"
                   VerticalOptions="Center" />
            <Entry Text="{Binding FelelosSzemelyTelefonszam}"
                   Grid.Row="7"
                   Grid.Column="1"
                   Keyboard="Telephone" />

            <Label Text="{x:Static res:AppRes.FelelosSzemelyEmail}"
                   Grid.Row="8"
                   Grid.Column="0"
                   VerticalOptions="Center" />
            <Entry Text="{Binding FelelosSzemelyEmail}"
                   Grid.Row="8"
                   Grid.Column="1"
                   Keyboard="Email" />

            <Label Text="{x:Static res:AppRes.Megjegyzes}"
                   Grid.Row="9"
                   Grid.Column="0"
                   VerticalOptions="Start"
                   Margin="0,10,0,0" />
            <Editor Text="{Binding Megjegyzes}"
                    Grid.Row="9"
                    Grid.Column="1"
                    MinimumHeightRequest="80" />

            <Button Text="{x:Static res:AppRes.Save}"
                    Grid.Row="10"
                    Grid.ColumnSpan="2"
                    Margin="0,20,0,0"
                    Command="{Binding SaveCommand}" />
        </Grid>
    </ScrollView>
</pages:BasePage>